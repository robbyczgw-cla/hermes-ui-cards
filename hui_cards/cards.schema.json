{
  "$comment": "Single source of truth for card shapes. Read by hui_cards/schema.py (validation in the tool) and by scripts/build.py, which embeds it in desktop/plugin.js and generates desktop/cards.d.ts. Subset of JSON Schema plus x-rules (cross-field checks implemented in both validators).",
  "version": 1,
  "limits": {
    "maxCardBytes": 24000,
    "maxReplyChars": 4000
  },
  "common": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "description": "Card type."
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$",
        "description": "Short slug you choose, e.g. \"trip-style\". Optional."
      },
      "lang": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
        "description": "Language of the card text (\"en\", \"de\"). Sets the language of buttons and hints. Optional."
      }
    }
  },
  "definitions": {
    "image": {
      "type": "string",
      "format": "https-url",
      "maxLength": 2000,
      "description": "https image URL that came from a tool or the user. Never invent one."
    },
    "icon": {
      "type": "string",
      "maxLength": 8,
      "format": "no-space",
      "description": "One emoji."
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "itemId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
    }
  },
  "cards": {
    "plan": {
      "phase": 3,
      "summary": "Edit and run a plan.",
      "type": "object",
      "required": [
        "title",
        "steps"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "summary": {
          "$ref": "text"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "title": {
                "$ref": "shortText"
              },
              "detail": {
                "$ref": "text"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "risk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "optional": {
                "type": "boolean",
                "default": false
              },
              "off": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "runLabel": {
          "$ref": "label"
        }
      },
      "x-rules": [
        "uniqueStepIds",
        "planOffOptional"
      ]
    },
    "review": {
      "phase": 3,
      "summary": "Review items together.",
      "type": "object",
      "required": [
        "title",
        "items"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "summary": {
          "$ref": "text"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "title": {
                "$ref": "shortText"
              },
              "detail": {
                "$ref": "text"
              },
              "preview": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            }
          }
        },
        "defaultDecision": {
          "type": "string",
          "enum": [
            "keep",
            "drop",
            "none"
          ],
          "default": "none"
        },
        "keepLabel": {
          "$ref": "label"
        },
        "dropLabel": {
          "$ref": "label"
        },
        "applyLabel": {
          "$ref": "label"
        }
      },
      "x-rules": [
        "uniqueItemIds"
      ]
    },
    "checklist": {
      "phase": 1,
      "summary": "Items the user ticks off; the ticks are kept when the chat is reopened. \"Done\" reports checked and open items.",
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "text": {
                "$ref": "text"
              },
              "note": {
                "$ref": "text"
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Groups items under a heading."
              },
              "checked": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "doneLabel": {
          "$ref": "label"
        }
      },
      "x-rules": [
        "uniqueItemIds"
      ]
    },
    "compare": {
      "phase": 1,
      "summary": "2-4 candidates side by side with aligned attribute rows, one may be marked best; each column has a pick button.",
      "type": "object",
      "required": [
        "columns"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "title": {
                "$ref": "shortText"
              },
              "subtitle": {
                "$ref": "text"
              },
              "badge": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "image": {
                "$ref": "image"
              },
              "best": {
                "type": "boolean",
                "default": false,
                "description": "Your recommendation (at most one column)."
              },
              "pros": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "$ref": "text"
                }
              },
              "cons": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "$ref": "text"
                }
              },
              "source": {
                "type": "object",
                "required": [
                  "label",
                  "url"
                ],
                "properties": {
                  "label": {
                    "$ref": "label"
                  },
                  "url": {
                    "$ref": "image",
                    "description": "HTTPS source URL; never invent one."
                  }
                }
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 12,
          "description": "Attribute rows; values[i] belongs to columns[i].",
          "items": {
            "type": "object",
            "required": [
              "label",
              "values"
            ],
            "properties": {
              "label": {
                "$ref": "shortText"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "maxLength": 120
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "https-url",
                  "maxLength": 2000
                }
              },
              "best": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "selectLabel": {
          "$ref": "label"
        },
        "asOf": {
          "type": "string",
          "maxLength": 40
        }
      },
      "x-rules": [
        "uniqueColumnIds",
        "rowsMatchColumns",
        "singleBest",
        "rowSourcesMatchValues",
        "rowBestInColumns"
      ]
    },
    "form": {
      "phase": 1,
      "summary": "Fields the user fills in (text, number, date, select, toggle) with required fields and checks.",
      "type": "object",
      "required": [
        "fields"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "description": {
          "$ref": "text"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "name",
              "label",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
              },
              "label": {
                "$ref": "shortText"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "textarea",
                  "number",
                  "date",
                  "time",
                  "email",
                  "select",
                  "toggle"
                ]
              },
              "required": {
                "type": "boolean",
                "default": false
              },
              "placeholder": {
                "type": "string",
                "maxLength": 80
              },
              "help": {
                "$ref": "text"
              },
              "default": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ],
                "maxLength": 1000
              },
              "min": {
                "type": "number",
                "description": "number: smallest value."
              },
              "max": {
                "type": "number",
                "description": "number: largest value."
              },
              "step": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "maxLength": 12
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 20,
                "items": {
                  "$ref": "shortText"
                },
                "description": "select: the choices."
              }
            }
          }
        },
        "submitLabel": {
          "$ref": "label"
        }
      },
      "x-rules": [
        "uniqueFieldNames",
        "fieldKindRules"
      ]
    },
    "confirm": {
      "phase": 1,
      "summary": "Ask before you act: one action with reason and risk; the user answers Yes, No or Change.",
      "type": "object",
      "required": [
        "title",
        "action"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "action": {
          "$ref": "text",
          "description": "What exactly will happen."
        },
        "reason": {
          "$ref": "text"
        },
        "risk": {
          "type": "object",
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "text": {
              "$ref": "text"
            }
          }
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Command or code shown monospace."
        },
        "details": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "$ref": "shortText"
              },
              "value": {
                "$ref": "text"
              }
            }
          }
        },
        "confirmLabel": {
          "$ref": "label"
        },
        "cancelLabel": {
          "$ref": "label"
        },
        "allowChange": {
          "type": "boolean",
          "default": true,
          "description": "Offer \"Change\" with a text field."
        }
      },
      "x-rules": []
    },
    "steps": {
      "phase": 2,
      "summary": "A guided walkthrough, one step at a time with Back/Next; the user reports done or where they got stuck.",
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "$ref": "shortText"
              },
              "body": {
                "$ref": "longText"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "image": {
                "$ref": "image"
              }
            }
          }
        },
        "finishLabel": {
          "$ref": "label"
        }
      },
      "x-rules": []
    },
    "decision": {
      "phase": 3,
      "summary": "Compare weighted options.",
      "type": "object",
      "required": [
        "title",
        "criteria",
        "options"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "weight"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "label": {
                "$ref": "shortText"
              },
              "weight": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "label",
              "scores"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "label": {
                "$ref": "shortText"
              },
              "scores": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                }
              },
              "note": {
                "$ref": "text"
              }
            }
          }
        },
        "note": {
          "$ref": "text"
        },
        "submitLabel": {
          "$ref": "label"
        }
      },
      "x-rules": [
        "uniqueCriterionIds",
        "uniqueOptionIds",
        "scoresMatchCriteria"
      ]
    },
    "calc": {
      "phase": 3,
      "summary": "Calculate outputs from inputs.",
      "type": "object",
      "required": [
        "title",
        "inputs",
        "outputs"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "name",
              "label",
              "default"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"
              },
              "label": {
                "$ref": "shortText"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "number",
                  "slider",
                  "select",
                  "toggle"
                ],
                "default": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "default": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "value"
                  ],
                  "properties": {
                    "label": {
                      "$ref": "shortText"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "label",
              "expr"
            ],
            "properties": {
              "label": {
                "$ref": "shortText"
              },
              "expr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "format": {
                "type": "string",
                "enum": [
                  "number",
                  "integer",
                  "percent",
                  "currency"
                ],
                "default": "number"
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "emphasis": {
                "type": "boolean"
              }
            }
          }
        },
        "note": {
          "$ref": "text"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "EUR"
        },
        "sendLabel": {
          "$ref": "label"
        }
      },
      "x-rules": [
        "uniqueInputNames",
        "calcExpressions",
        "calcInputs"
      ]
    },
    "rank": {
      "phase": 3,
      "summary": "Put items in order.",
      "type": "object",
      "required": [
        "title",
        "items"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "prompt": {
          "$ref": "text"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "label": {
                "$ref": "shortText"
              },
              "detail": {
                "$ref": "text"
              }
            }
          }
        },
        "submitLabel": {
          "$ref": "label"
        }
      },
      "x-rules": [
        "uniqueItemIds"
      ]
    },
    "choice": {
      "phase": 1,
      "summary": "Pick several of 2-6 options, or options that need a picture or a short text each. For one plain question with simple options use the built-in clarify tool instead.",
      "type": "object",
      "required": [
        "question",
        "options"
      ],
      "properties": {
        "question": {
          "$ref": "text"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "label": {
                "$ref": "shortText"
              },
              "description": {
                "$ref": "text"
              },
              "icon": {
                "$ref": "icon"
              },
              "image": {
                "$ref": "image"
              },
              "badge": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            }
          }
        },
        "multiple": {
          "type": "boolean",
          "default": false,
          "description": "Allow several picks."
        },
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "Fewest picks (multiple only)."
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "Most picks (multiple only)."
        },
        "allowOther": {
          "type": "boolean",
          "default": false,
          "description": "Add a free-text \"Other\" field."
        },
        "submitLabel": {
          "$ref": "label"
        }
      },
      "x-rules": [
        "uniqueOptionIds",
        "minMaxPicks"
      ]
    },
    "schedule": {
      "phase": 2,
      "summary": "Offer time slots to pick from (meetings, appointments).",
      "type": "object",
      "required": [
        "slots"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "timezone": {
          "type": "string",
          "maxLength": 64,
          "description": "IANA zone, e.g. \"Europe/Vienna\"."
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "start"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "start": {
                "type": "string",
                "format": "datetime",
                "description": "ISO 8601, e.g. 2026-11-12T14:00"
              },
              "end": {
                "type": "string",
                "format": "datetime"
              },
              "label": {
                "$ref": "shortText"
              },
              "note": {
                "$ref": "text"
              },
              "unavailable": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "multiple": {
          "type": "boolean",
          "default": false
        },
        "noneLabel": {
          "$ref": "label",
          "description": "Button for \"none of these fit\"."
        }
      },
      "x-rules": [
        "uniqueSlotIds",
        "slotOrder"
      ]
    },
    "recipe": {
      "phase": 3,
      "summary": "Scale a recipe and make a shopping list.",
      "type": "object",
      "required": [
        "title",
        "servings",
        "ingredients"
      ],
      "properties": {
        "title": {
          "$ref": "shortText"
        },
        "servings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": [
              "item"
            ],
            "properties": {
              "id": {
                "$ref": "itemId"
              },
              "item": {
                "$ref": "shortText"
              },
              "qty": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "$ref": "text"
              },
              "minutes": {
                "type": "integer",
                "minimum": 1,

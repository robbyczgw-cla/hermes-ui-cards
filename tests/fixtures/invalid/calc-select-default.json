{
  "type": "calc",
  "title": "Monthly cost",
  "inputs": [
    {
      "name": "price",
      "label": "Price",
      "default": 1200,
      "kind": "select",
      "options": [
        {
          "label": "a",
          "value": 1
        },
        {
          "label": "b",
          "value": 2
        }
      ]
    },
    {
      "name": "months",
      "label": "Months",
      "default": 12
    }
  ],
  "outputs": [
    {
      "label": "Monthly",
      "expr": "price / months",
      "format": "currency"
    }
  ]
}

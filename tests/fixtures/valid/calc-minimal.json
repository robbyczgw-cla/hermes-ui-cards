{
  "type": "calc",
  "title": "Monthly cost",
  "inputs": [
    {
      "name": "price",
      "label": "Price",
      "default": 1200
    },
    {
      "name": "months",
      "label": "Months",
      "default": 12
    }
  ],
  "outputs": [
    {
      "label": "Monthly",
      "expr": "price / months",
      "format": "currency"
    }
  ]
}
